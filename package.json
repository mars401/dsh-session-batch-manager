{
  "name": "dsh-session-batch-manager",
  "version": "0.1.0",
  "description": "DeepSeek Harness session batch manager —— sidebar multi-select, batch archive / unarchive / delete, and session management dashboard with token usage, cache and context pressure visualization. | DSH 会话批量管理——侧栏多选、批量归档/恢复/删除，以及会话管理面板（token 消耗、缓存、上下文占比可视化）。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "plugin",
    "session",
    "session-manager",
    "batch",
    "batch-operations",
    "archive",
    "delete",
    "dashboard",
    "token-usage",
    "context-pressure",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mars401/dsh-session-batch-manager.git"
  },
  "bugs": {
    "url": "https://github.com/mars401/dsh-session-batch-manager/issues"
  },
  "homepage": "https://github.com/mars401/dsh-session-batch-manager",
  "type": "module",
  "icon": "./icon.svg",
  "engines": {
    "dsh": ">=0.2.2-alpha.2"
  },
  "main": "lib/host/index.js",
  "exports": {
    ".": "./lib/host/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/stats.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.6-alpha.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.2"
  }
}